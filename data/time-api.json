            "type": "TFunction",
            "name": "F~t_parseDate",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Parses a date string into milliseconds since the Unix epoch."
                },
                {
                    "tagType": "returns",
                    "description": "A number representing the parsed date in milliseconds."
                },
                {
                    "tagType": "devnote",
                    "description": "If no timezone is provided, a default timezone of UTC is used."
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "@ Import jaiva/time/zone",
                        "tsea \"jaiva/time/zone\" <- TZ_AfricaJohannesburg!",
                        "maak ms <- t_parseDate(\"2023-10-05 14:30:00\", \"yyyy-MM-dd HH:mm:ss\", TZ_AfricaJohannesburg)!",
                        "khuluma(ms)! @ Outputs the milliseconds since epoch for the given date in the specified timezone."
                    ]
                },
                {
                    "tagType": "from",
                    "version": "5.0.0"
                },
                {
