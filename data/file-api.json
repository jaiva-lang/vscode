                {
                    "tagType": "GENERIC",
                    "description": "Finds the specified file and retrieves it's contents."
                },
                {
                    "tagType": "returns",
                    "description": "Returns an array containing the properties of the file at the given `path` \n [fileName, fileDir, [contents], [canRead?, canWrite?, canExecute?]]"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak file <- f_file(\"data/myFile.txt\")!",
                        "khuluma(\"FileApi name: \" + file[0])!",
                        "khuluma(\"FileApi directory: \" + file[1])!"
                    ]
                },
