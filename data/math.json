        {
            "type": "TFunction",
            "name": "F~m_random",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Returns a random number in the range of `a` and `b`, If both are omitted, returns a random (double) between 0 and 1."
                },
                {
                    "tagType": "devnote",
                    "description": "Unlike other functions, if you provide no arguments, this function returns a double between 0 and 1. If you provide only one argument, it is treated as the upper bound, with the lower bound being 0. If you're coming from a normal programming lang, don't worry both ints are inclusive"
                },
                {
                    "tagType": "returns",
                    "description": "A random number."
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "khuluma(\"Random number between 1 and 10: \" + m_random(1, 10))!",
                        "khuluma(\"Random number between 0 and 5: \" + m_random(5))!",
                        "khuluma(\"Random number between 0 and 1: \" + m_random())!"
                    ]
                },
                {
                    "tagType": "from",
                    "version": "1.0.0"
                },
                {
                    "tagType": "parameter",
                    "description": "The highest number possible between `a` and 0, otherwise the lwoest between `a` and `b` (inclusive)",
                    "var": "a",
                    "type": "number",
                    "optional": true
                },
                {
                    "tagType": "parameter",
                    "description": "The highest number possible between a and b (inclusive)",
                    "var": "b",
                    "type": "number",
                    "optional": true
                }
            ],
            "lineNumber": -1,
            "args": [
                "a",
                "b"
            ],
            "isArgOptional": [
                true,
                true
            ],
            "varArgs": false,
            "body": null
