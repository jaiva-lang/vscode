            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "The mathematical constant ? (tau), which is equal to 2?"
                },
                {
                    "tagType": "devnote",
                    "description": "Just java.lang.Math.TAU"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "@ Using tau to calculate the circumference of a circle with radius 5",
                        "maak radius <- 5!",
                        "maak circumference <- m_tau * radius!",
                        "khuluma(circumference)! @ approximately 31.41592653589793"
                    ]
                }
            ],
            "lineNumber": -1,
            "value": 6.283185307179586
        },
