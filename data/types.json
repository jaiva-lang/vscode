{
    "version": "6.1.2",
    "tokens": [
        {
            "type": "TFunction",
            "name": "F~t_num",
            "exportSymbol": false,
            "toolTip": [
                {
                    "description": "Converts a given **string** to a number with an optional **radix**.",
                    "tagType": "GENERIC"
                },
                {
                    "description": "Jaiva integer prefixes [such as _0x_ or _0b_], are checked for first before the radix. If the resulting input is too big, a long may be returned instead of an integer",
                    "tagType": "devnote"
                },
                {
                    "description": "A number. (Either a double, integer or long)",
                    "tagType": "returns"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "khuluma(t_num(\"0b1010\"))! @ prints 10",
                        "khuluma(t_num(\"FF\", 16))! @ prints 255",
                        "khuluma(t_num(\"3.14\"))! @ prints 3.14",
                        "khuluma(t_num(\"0x1A\"))! @ prints 26",
                        "khuluma(t_num(\"30129382409L\"))! @ prints 30129382409 (as a long value)"
                    ]
                },
                {
                    "tagType": "from",
                    "version": "2.0.0-beta.3"
                },
                {
                    "description": "The input to convert to a number",
                    "tagType": "parameter",
                    "var": "string",
                    "type": "string",
                    "optional": false
                },
                {
                    "description": "An optional radix to convert to",
                    "tagType": "parameter",
                    "var": "radix",
                    "type": "number",
                    "optional": true
                }
            ],
            "lineNumber": -1,
            "args": [
                "string",
                "radix"
            ],
            "isArgOptional": [
                false,
                true
            ],
            "varArgs": false,
            "body": null
        },
        {
            "type": "TFunction",
            "name": "F~t_str",
            "exportSymbol": false,
            "toolTip": [
                {
                    "description": "Converts any input of any given type to a string.",
                    "tagType": "GENERIC"
                },
                {
                    "description": "A string representation of the given input",
                    "tagType": "returns"
                },
                {
                    "description": "If given an input of `idk`, it will return `idk`. Not a string.",
                    "tagType": "devnote"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "khuluma(t_str(255))! @ prints \"255\"",
                        "khuluma(t_str(true))! @ prints \"yebo\"",
                        "khuluma(t_str(yebo))! @ prints \"yebo\"",
                        "khuluma(t_str(10, 2))! @ prints \"0b1010\""
                    ]
                },
                {
                    "tagType": "from",
                    "version": "2.0.0-beta.3"
                },
                {
                    "description": "The input to convert",
                    "tagType": "parameter",
                    "var": "input",
                    "type": "idk",
                    "optional": true
                },
                {
                    "description": "A given radix for integers or longs",
                    "tagType": "parameter",
                    "var": "radix",
                    "type": "number",
                    "optional": true
                }
            ],
            "lineNumber": -1,
            "args": [
                "input",
                "radix"
            ],
            "isArgOptional": [
                true,
                true
            ],
            "varArgs": false,
            "body": null
        },
