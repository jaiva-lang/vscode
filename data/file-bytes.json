{
    "version": "7.0.0-beta.2",
    "tokens": [
        {
            "type": "TFunction",
            "name": "F~f_creader",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "from",
                    "version": "6.1.0"
                },
                {
                    "description": "Provides byte level reads into a file.",
                    "tagType": "GENERIC"
                },
                {
                    "description": "Returns a [Continuous Function](../Continuous-Functions.md) over the file reading resource.",
                    "tagType": "returns"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "tsea \"jaiva/file/bytes\"!",
                        "tsea \"jaiva/continuous!\"",
                        "tsea \"jaiva/types/numbers\"!",
                        "",
                        "@ If the file contains a UTF8 string then a 255 byte value",
                        "",
                        "maak conf <- f_creader(\"C:\\Users\\Wow\\myFile.jib\")!",
                        "maak read <- conf(C_READ)!",
                        "maak collected <- aowa!",
                        "",
                        "maak collect <-|!",
                        "",
                        "nikhil (conf(C_EOF)()') ->",
                        "    maak byte <- read(F_R_BYTE)!",
                        "",
                        "    sif (byte?) <? nevermind!",
                        "",
                        "    sif (byte != 255) ?> collect <- arrLit(collect:::, byte)!",
                        "<~",
                        "",
                        "conf(C_CLOSE)()!",
                        "",
                        "khuluma(t_strFromByteArr(collect:::))!"
                    ]
                },
                {
                    "description": "Absolute path",
                    "tagType": "parameter",
                    "var": "filePath",
                    "type": "string",
                    "optional": false
                }
            ],
            "lineNumber": -1,
            "args": [
                "filePath"
            ],
            "isArgOptional": [
                false
            ],
            "varArgs": false,
            "body": null
        },
        {
            "type": "TFunction",
            "name": "F~f_cwriter",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "from",
                    "version": "6.1.0"
                },
                {
                    "description": "Provides byte level writes into a file.",
                    "tagType": "GENERIC"
                },
                {
                    "description": "Returns a [Continuous Function](../Continuous-Functions.md) over the file writing resource.",
                    "tagType": "returns"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "tsea \"jaiva/file/bytes\"!",
                        "tsea \"jaiva/continuous!\"",
                        "",
                        "maak cont <- f_cwriter(\"C:\\Users\\Wow\\myFile.jib\")!",
                        "maak write <- cont(C_OUTPUT)!",
                        "",
                        "write(F_W_UTF8, \"What's Up Dawg??\")!",
                        "write(F_W_BYTE, 255)! @ Write 255 marker so we know where the UTF8 bytes end.",
                        "",
                        "cont(C_FLUSH)()!",
                        "cont(C_CLOSE)()!"
                    ]
                },
                {
                    "description": "The (Absolute) file path to write to.",
                    "tagType": "parameter",
                    "var": "filePath",
                    "type": "string",
                    "optional": false
                },
                {
                    "description": "Append to the file if it already exists, otherwise overwrite. Defaults to true, which appends.",
                    "tagType": "parameter",
                    "var": "append",
                    "type": "boolean",
                    "optional": true
                }
            ],
            "lineNumber": -1,
            "args": [
                "filePath",
                "append"
            ],
            "isArgOptional": [
                false,
                true
            ],
            "varArgs": false,
            "body": null
        },
