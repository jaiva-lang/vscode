        {
            "type": "TFunction",
            "name": "F~d_link",
            "exportSymbol": false,
            "toolTip": [
                {
                    "tagType": "GENERIC",
                    "description": "Links the MapValue instance of 'a' into 'b' such that they hold the same value and if one is edited the other will also have that edit."
                },
                {
                    "tagType": "from",
                    "version": "5.0.4"
                },
                {
                    "tagType": "returns",
                    "description": "idk"
                },
                {
                    "tagType": "devnote",
                    "description": "A usual (b <- a) syntax would suffice if you'd like to copy the value of a into b.\nHowever when a is changed, b will stay the value you set earlier. This function fixes that where it will\nlink the exact MapValue from a into b, discarding b's old MapValue. such that editing any one of the symbols\nvia the reassignment syntax will update the linked variable.\n\nIn the case that the \"b\" parameter does not actually exist in the symbol table, d_link will try to make it, itself.\n"
                },
                {
                    "tagType": "example",
                    "codeblock": [
                        "maak a <- f~() : 10! @ Lambda that returns 10",
                        "maak b <- true! @ boolean value true",
                        "",
                        "@ With normal reassignment syntax, setting b to a then changing b does not update a",
                        "b <- a!",
                        "b <- 10!",
                        "khuluma(a)! @ prints the lambda signature and not 10.",
                        "",
                        "@ With d_link, the exact MapValue held by that alias is copied.",
                        "d_link(a, b)!",
                        "b <- 10!",
                        "khuluma(a)! @ prints 10",
                        "a <- 100!",
                        "khuluma(b)! @ prints 100"
                    ]
                },
                {
                    "tagType": "parameter",
                    "description": "The symbol which holds the MapValue to be linked.",
                    "var": "a",
                    "type": "idk",
                    "optional": false
                },
                {
                    "tagType": "parameter",
                    "description": "The symbol who's MapValue will either be created or overwritten",
                    "var": "b",
                    "type": "idk",
                    "optional": false
                }
            ],
            "lineNumber": -1,
            "args": [
                "a",
                "b"
            ],
            "isArgOptional": [
                false,
                false
            ],
            "varArgs": false,
            "body": null
        },
